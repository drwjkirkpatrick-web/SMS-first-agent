# SMS-First Agent — Environment Configuration
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════

# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO
SCHOOL_TIMEZONE=Africa/Nairobi
BUSINESS_HOURS_START=7
BUSINESS_HOURS_END=19
MAX_SMS_SEGMENTS=2

# ── Database ──
DATABASE_URL=postgresql+asyncpg://sms_agent:changeme_secure@db:5432/sms_first_agent

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Africa's Talking (Primary SMS Provider) ──
AFRICAS_TALKING_USERNAME=your_username
AFRICAS_TALKING_API_KEY=your_api_key
AFRICAS_TALKING_SENDER_ID=YOUR-BIZ
AFRICAS_TALKING_SHORT_CODE=12345

# ── Twilio (Fallback SMS Provider) ──
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ── M-Pesa (Safaricom Daraja API) ──
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORT_CODE=123456
MPESA_PASSKEY=your_passkey
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://your-domain.com/webhooks/mpesa

# ── SMS Budget Control ──
DAILY_SMS_BUDGET_KES=500

# ── Admin ──
ADMIN_TOKEN=change_this_to_a_secure_random_string

# ── Security ──
WEBHOOK_SECRET=your_webhook_secret

# ── v2 Additions ──

# E7: Database connection pool sizing
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# S6: CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# R9: Admin alert phone for failure threshold SMS alerts
ADMIN_ALERT_PHONE=+254700000000

# R10: Backup output directory
BACKUP_OUTPUT_DIR=/data/backups

# S8: TLS domain for production certificates
# TLS_DOMAIN=your-business-domain.com